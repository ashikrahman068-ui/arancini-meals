{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_email": {
      "type": "string",
      "description": "Email of the user who referred"
    },
    "referrer_code": {
      "type": "string",
      "description": "Referral code used"
    },
    "referred_email": {
      "type": "string",
      "description": "Email of the referred user"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "expired"
      ],
      "default": "pending",
      "description": "Status of the referral"
    },
    "reward_type": {
      "type": "string",
      "enum": [
        "credit",
        "discount",
        "free_delivery"
      ],
      "description": "Type of reward given"
    },
    "referrer_reward_amount": {
      "type": "number",
      "description": "Reward amount for referrer"
    },
    "referred_reward_amount": {
      "type": "number",
      "description": "Reward amount for referred user"
    },
    "completion_date": {
      "type": "string",
      "format": "date",
      "description": "Date when referral was completed"
    },
    "subscription_id": {
      "type": "string",
      "description": "Subscription ID that completed the referral"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "referrer_email",
    "referrer_code",
    "referred_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "referrer_email": "{{user.email}}"
        },
        {
          "referred_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}